    text-align: center;
  }

  .compact-list li {
    margin-bottom: var(--space-1);
    line-height: 1.5;
  }

  .photo-row {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .photo-row figure {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .photo-row {
      flex-direction: column;
    }
  }

  .post__content figure img {
    display: block;
    margin: 0 auto var(--space-1);
  }

  figcaption {
    font-size: 1.1rem;
    color: var(--color-text-muted, #666);
    font-style: italic;
  }
</style>
