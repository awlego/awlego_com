---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWritingPosts, getPostType } from '../utils/posts';

// Featured posts - pick a few recent ones with good excerpts
const featuredPosts = (await getWritingPosts()).slice(0, 10);
---

<BaseLayout title="Alex Wilson" description="Alex Wilson's homepage">
  <!-- Featured writing section -->
  <section>
    <h2>Recent Writing</h2>

    <div class="posts">
      {featuredPosts.map((post) => {
        const postType = getPostType(post);
        return (
          <a href={`/writing/${post.id}/`} class:list={['post-entry', { 'post-entry--poem': postType === 'poem' }]}>
            <div class="post-entry__bar"></div>
            <div class="post-entry__header">
              <h3 class="post-entry__title">{post.data.title}</h3>
              <span class:list={['tag', `tag--${postType}`]}>
                {postType}
              </span>
            </div>
            {post.data.excerpt && (
              <p class="post-entry__excerpt">{post.data.excerpt}</p>
            )}
          </a>
        );
      })}
    </div>

    <p style="margin-top: var(--space-5);">
      <a href="/writing" style="color: var(--color-accent);">View all writing →</a>
    </p>
  </section>
</BaseLayout>
